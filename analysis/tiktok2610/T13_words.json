"sents": [
{
"s": 0.0,
"e": 4.42,
"text": "Que el Banco Central dé celeridad al sumario que está haciendo, no esperar mucho tiempo,"
},
{
"s": 4.56,
"e": 8.88,
"text": "y que no me hable del secreto bancario, y que no informe para mañana,"
},
{
"s": 9.12,
"e": 12.5,
"text": "que le haga trabajar fuera de hora a su funcionario, ¿qué más da?"
},
{
"s": 12.64,
"e": 18.7,
"text": "Si eso es mantener la tranquilidad para la ciudadanía, y la sanción, si se merece, cualquier banco."
},
{
"s": 18.96,
"e": 22.32,
"text": "¿Vos creés que se tiene que cambiar, para recuperar la confianza,"
},
{
"s": 22.32,
"e": 24.46,
"text": "se le tiene que cambiar a los miembros del Banco Central del Paraguay?"
},
{
"s": 24.68,
"e": 25.2,
"text": "Al presidente."
},
{
"s": 25.54,
"e": 26.3,
"text": "A Carvalho."
},
{
"s": 26.54,
"e": 26.98,
"text": "Coincido."
},
{
"s": 26.98,
"e": 32.04,
"text": "Por la duda. Nosotros necesitamos recuperar la confianza ciudadana, entonces esa es prioridad."
}

"sents": [
{
"s": 0.0,
"e": 4.92,
"text": "El patrimonio del IPS es de los asegurados. El Estado no es el dueño del IPS."
},
{
"s": 5.28,
"e": 14.38,
"text": "Lo que quiero resaltar con este tema es que la presentación la hicieron entre el IPS y Salud Pública para crear un solo frente de salud, hablan."
},
{
"s": 14.44,
"e": 20.96,
"text": "El patrimonio del IPS es de los asegurados y tiene tres dueños en base a nuestra Constitución Nacional."
},
{
"s": 21.18,
"e": 27.56,
"text": "Los empleadores, los aportantes y los jubilados que durante toda su vida aportaron."
},
{
"s": 27.56,
"e": 33.3,
"text": "Entonces, el Estado es solamente administrador y garante, no es el dueño del IPS."
}
]

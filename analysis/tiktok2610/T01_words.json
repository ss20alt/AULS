],
"sents": [
{
"s": 0.0,
"e": 3.86,
"text": "Estamos con un gran desafío en corto tiempo."
},
{
"s": 4.18,
"e": 17.68,
"text": "El año que viene, en diciembre, se hacen las internas para elegir al candidato o candidata a la presidencia de la República por el Partido Colorado, gobernadores, diputados, senadores."
},
{
"s": 17.68,
"e": 31.58,
"text": "Entonces, Causa Republicana en cada rincón de la patria tiene a los jóvenes, a los caudillos, a las valientes mujeres para asumir estos desafíos."
},
{
"s": 31.58,
"e": 55.06,
"text": "nosotros somos un movimiento independiente, disidente, no tenemos patrón, no tenemos jefes, nosotros somos nuestros jefes, nosotros somos los que vamos a definir que rumbo queremos para ser realmente alternativa o esperanza para los correligionarios y correligionarias"
},
{
"s": 55.06,
"e": 57.56,
"text": "Y más cuando vemos lo que está pasando."
},
{
"s": 57.86,
"e": 64.12,
"text": "Y hoy, a través del esfuerzo, del sacrificio que ustedes han hecho para llegar hasta aquí,"
},
{
"s": 64.22,
"e": 71.22,
"text": "me dirijo a mis correligionarias y correligionarios de causa republicana a nivel nacional."
},
{
"s": 71.42,
"e": 79.04,
"text": "Con la ayuda de Dios y de ustedes, seré la próxima presidenta de la República del Paraguay a través del Partido Colorado."
},
{
"s": 79.92,
"e": 89.74,
"text": "La única senadora que de aquí para allá, opinando, dando ideas, proyectos por el bien de la gente."
},
{
"s": 90.02,
"e": 93.48,
"text": "Y ahora queremos que tú llegues también a la presidencia de la República."
},
{
"s": 94.18,
"e": 96.2,
"text": "Senadora, gracias por representarnos."
},
{
"s": 96.26,
"e": 101.14,
"text": "Vemos todos los días en las redes sociales, como dijo la compañera, en cada postura que tenés."
},
{
"s": 101.14,
"e": 107.78,
"text": "Y todas esas propuestas, todas esas leyes que nuestra senadora fue la que promovió,"
},
{
"s": 107.86,
"e": 110.12,
"text": "están nosotros que la gente se entere."
},
{
"s": 110.46,
"e": 116.54,
"text": "Nuestro apoyo desde Corillera, manos a la obra, hay un largo camino que recorrer,"
},
{
"s": 117.01,
"e": 119.18,
"text": "va a ser difícil pero no va a ser imposible."
},
{
"s": 119.46,
"e": 125.46,
"text": "Los colorados de bien estamos gritando la necesidad de conducción y está en sus manos."
},
{
"s": 125.46,
"e": 146.42,
"text": "Y no encontramos nadie que tenga la trayectoria, la capacidad, la convicción, la postura y la actitud de una paraguaya auténticamente colorada y que ama a su país, como es la senadora Lidia Samañero."
}
]

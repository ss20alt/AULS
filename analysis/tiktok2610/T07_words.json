"sents": [
{
"s": 0.0,
"e": 7.84,
"text": "Al pueblo colorado, a los intendentes que han mantenido la identidad del partido y fueron reelectos,"
},
{
"s": 7.84,
"e": 16.9,
"text": "y a aquellos intendentes que han logrado recuperar la intendencia de mano de los opositores, que fueron 24,"
},
{
"s": 17.44,
"e": 25.74,
"text": "les felicito por esta gran victoria porque lo han logrado con el sentido de pertenencia, con las tradiciones del partido colorado."
},
{
"s": 25.74,
"e": 33.54,
"text": "Y esto fue posible gracias al apoyo de los gobernadores y del presidente de la República, Santiago Peña."
}

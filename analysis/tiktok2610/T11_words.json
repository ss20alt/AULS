"sents": [
{
"s": 0.0,
"e": 1.84,
"text": "Pasó 34 años de sacrificio y..."
},
{
"s": 1.84,
"e": 5.62,
"text": "Javier de Cuth me pide que le siga defendiendo a los jubilados."
},
{
"s": 5.72,
"e": 10.3,
"text": "Por supuesto, yo fui funcionaria 14 años del IPS,"
},
{
"s": 10.64,
"e": 13.22,
"text": "gran defensora de la previsional,"
},
{
"s": 13.92,
"e": 16.78,
"text": "única herramienta que tiene el pueblo paraguayo,"
},
{
"s": 16.86,
"e": 20.02,
"text": "los jubilados y los que hoy aportan."
},
{
"s": 20.08,
"e": 25.52,
"text": "Nosotros no podemos permitir que otros toquen los fondos jubilatorios."
},
{
"s": 25.64,
"e": 28.2,
"text": "A mí me van a tener en defensa del IPS,"
},
{
"s": 28.2,
"e": 30.56,
"text": "ni tampoco que se fusione con salud pública."
},
{
"s": 30.74,
"e": 36.78,
"text": "IPS sus dueños son los aportantes, los empleados y los jubilados"
},
{
"s": 36.78,
"e": 42.32,
"text": "que toda la vida pagaron el IPS y el patrimonio es de los asegurados."
},
{
"s": 42.5,
"e": 44.54,
"text": "Yo pasé 34 años de sacrificio y..."
},
{
"s": 44.54,
"e": 49.48,
"text": "Acá le tenés, 34 años de CUT, pasó aportando al IPS,"
},
{
"s": 49.56,
"e": 53.08,
"text": "trabajando dignamente para tener su jubilación,"
},
{
"s": 53.08,
"e": 58.38,
"text": "Que tiene el derecho, hasta que Dios le lleve, de seguir cobrando su jubilación."
},
{
"s": 58.58,
"e": 60.0,
"text": "A mí me vas a tener siempre."
},
{
"s": 60.28,
"e": 60.8,
"text": "Siempre."
}
]

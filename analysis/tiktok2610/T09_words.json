"sents": [
{
"s": 2.72,
"e": 6.7,
"text": "Sofía, contale a la gente cómo haces la botifarra, por favor."
},
{
"s": 31.94,
"e": 36.66,
"text": "Entonces la botifarra hoy, para mi familia, van a compartir, nos vamos a acordar de vos, Sofía."
},
{
"s": 36.82,
"e": 38.52,
"text": "Si querés probar, te voy a hacer probar."
},
{
"s": 38.62,
"e": 39.62,
"text": "Esta botifarra."
},
{
"s": 40.42,
"e": 41.5,
"text": "¿Esta ya fue la cocida?"
},
{
"s": 41.56,
"e": 43.0,
"text": "Sí, la cocida."
},
{
"s": 43.62,
"e": 44.6,
"text": "¿Esta es la traición?"
},
{
"s": 44.86,
"e": 45.56,
"text": "Sí, la cocida."
},
{
"s": 47.16,
"e": 47.64,
"text": "¿Pesenduque?"
},
{
"s": 49.54,
"e": 50.02,
"text": "¿Carbón?"
},
{
"s": 50.08,
"e": 52.12,
"text": "Sí, carbón, azúcar, caa."
},
{
"s": 52.42,
"e": 54.42,
"text": "¿Esta es la cocida?"
},
{
"s": 54.9,
"e": 55.48,
"text": "¿La cocida?"
},
{
"s": 55.76,
"e": 56.22,
"text": "Sí."
},
{
"s": 57.0,
"e": 58.14,
"text": "¿Esta es la cocida, Sofía?"
},
{
"s": 58.14,
"e": 60.66,
"text": "Estere, a ver, ¿cuáles están de atar las estere ahí?"
},
{
"s": 62.14,
"e": 63.32,
"text": "Mira, ahí está."
},
{
"s": 64.06,
"e": 65.0,
"text": "Esa es tu humilde santa."
},
{
"s": 67.5,
"e": 68.72,
"text": "Me encanta, Sofía."
},
{
"s": 68.88,
"e": 70.68,
"text": "Ayúdame a visitar."
},
{
"s": 70.7,
"e": 72.12,
"text": "Acú, ayúdame a atar las chispas."
},
{
"s": 72.28,
"e": 74.3,
"text": "Amor, mi amor, ayúdame a atar las chispas."
},
{
"s": 74.38,
"e": 74.94,
"text": "Estere ahí, vete."
}

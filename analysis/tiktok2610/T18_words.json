"sents": [
{
"s": 0.0,
"e": 7.32,
"text": "Vine a Cacupé para compartir la misa y conocer la espada de San Miguel de la Canje."
},
{
"s": 7.67,
"e": 16.02,
"text": "Qué bendición que tenemos los paraguayos de tener esta posibilidad de estar ante la espada de San Miguel"
},
{
"s": 16.02,
"e": 21.06,
"text": "que simboliza la lucha espiritual entre el bien y el mal."
},
{
"s": 21.06,
"e": 32.8,
"text": "Y Dios hizo posible que hoy esté en nuestro país, acá, compartiendo con los feligreses de la Virgen de Cacupé en la misa consagrada por su presencia."
},
{
"s": 32.94,
"e": 34.2,
"text": "Que pasen bien en familia."
},
{
"s": 34.52,
"e": 39.06,
"text": "Néstor Jara de Capietá, le vine a conocer acá. Gracias a la Virgen de Cacupé, Néstor."
},
{
"s": 39.06,
"e": 39.38,
"text": "Gracias, gracias."
},
{
"s": 39.7,
"e": 42.28,
"text": "Y anda a mirar la espada de San Miguel, que te bendiga."
},
{
"s": 42.58,
"e": 43.36,
"text": "Gracias, amén."
},
{
"s": 43.68,
"e": 44.16,
"text": "Encantada."
},
{
"s": 44.6,
"e": 45.62,
"text": "Una foto, ¿verdad?"
},
{
"s": 45.62,
"e": 45.9,
"text": "Dale."
}
]

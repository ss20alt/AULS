"sents": [
{
"s": 0.0,
"e": 3.64,
"text": "Nos salvamos de un virrey, afirma Beto Ovelar."
},
{
"s": 3.92,
"e": 6.66,
"text": "Te hago recordar porque tenés amnesia, Beto."
},
{
"s": 6.74,
"e": 10.16,
"text": "Yo fui presidenta del partido en septiembre del 2008."
},
{
"s": 10.62,
"e": 15.34,
"text": "Cartes ni intentaba afiliarse a ningún partido en ese entonces."
},
{
"s": 15.8,
"e": 20.44,
"text": "Yo le reconozco a Cartes que podía haberse afiliado al Partido Liberal"
},
{
"s": 20.44,
"e": 23.54,
"text": "de la mano de mi amiga Mirta Vergara"
},
{
"s": 23.54,
"e": 27.52,
"text": "y decidió afiliarse al Partido Colorado que estaba en la llanura."
},
{
"s": 27.52,
"e": 45.72,
"text": "Pero él apareció en el partido a finales del 2009, cuando para entonces yo, Lilian Samaniego, llevé adelante el Tribunal de Consenso Histórico del partido que le daba garantía a todos los colorados para participar en las elecciones."
},
{
"s": 45.72,
"e": 50.16,
"text": "Nos salvamos de un virrey, afirma Beto Ovelar."
},
{
"s": 50.3,
"e": 55.26,
"text": "Nos salvamos de un emperador en puertas, decía Beto Ovelar."
},
{
"s": 55.44,
"e": 57.72,
"text": "Muy cambiante es Beto en su posición."
},
{
"s": 58.04,
"e": 60.12,
"text": "Hoy eres más cartista que cartes."
},
{
"s": 60.14,
"e": 63.36,
"text": "Y ayer hablaba que era un emperador, un virrey."
},
{
"s": 63.5,
"e": 66.92,
"text": "Uno tiene que tener autoridad moral cuando hace sus reflexiones."
},
{
"s": 67.14,
"e": 69.98,
"text": "Siempre respeté tus posiciones, aunque no me gustaban."
},
{
"s": 70.14,
"e": 72.18,
"text": "Jamás te ofendí, ni mucho menos."
},
{
"s": 72.18,
"e": 76.76,
"text": "Y a vos te consta que fui una buena presidenta porque fuiste mi tesorero."
},
{
"s": 77.2,
"e": 81.8,
"text": "Jamás me objetaste, me acompañaste en el proceso de reconstrucción del partido."
},
{
"s": 82.06,
"e": 88.04,
"text": "Y te pregunto, Beto Velar, y espero que seas sincero, porque los dos somos veteranos de este lugar."
},
{
"s": 88.32,
"e": 96.14,
"text": "Cartes gobierna como gobernó Lilian Samaniego con todos los colorados disidentes que pensaban igual, que pensaban distinto."
},
{
"s": 96.14,
"e": 106.58,
"text": "Cártez gobierna hoy así. Pasaron tres años y jamás convocó a una reunión de senadores colorados, de diputados colorados en nuestra casa."
},
{
"s": 107.04,
"e": 112.32,
"text": "Policías te reciben en la puerta y no te dejan ingresar. Pregúntenle a Yamil Esgai."
},
{
"s": 112.52,
"e": 117.3,
"text": "Prefiere reunirse con los liberales que reunirse con sus correligionarios."
},
{
"s": 117.56,
"e": 125.78,
"text": "Él prefiere reunirse con Orlando Penner, que peleó para que Santiago Peña no sea presidente y Horacio Pearte no sea presidente del partido."
},
{
"s": 126.14,
"e": 133.96,
"text": "Prefiere reunirse con Patrick Kemper, que peleó para que Horacio Cártez no sea presidente y Santiago Peña no sea presidente."
},
{
"s": 134.26,
"e": 136.48,
"text": "No acepta la opinión disidente."
},
{
"s": 136.76,
"e": 140.8,
"text": "Entonces, Beto, yo no te ofendí nunca. No me llames oportunista porque no soy."
}
]

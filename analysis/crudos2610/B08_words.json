"sents": [
{
"s": 3.22,
"e": 5.88,
"text": "lo que se perciba y lo que lo vamos a sentir."
},
{
"s": 6.12,
"e": 9.96,
"text": "Hoy, por toda la gente que se está compartiendo,"
},
{
"s": 10.12,
"e": 13.4,
"text": "un año más de vida de nuestro querido Arnaldo Samaniego."
},
{
"s": 13.62,
"e": 17.56,
"text": "Por supuesto, y todos ustedes que están hoy aquí,"
},
{
"s": 17.66,
"e": 22.06,
"text": "hoy vamos a tener el clima, hoy vamos a tener las temperaturas."
},
{
"s": 29.15,
"e": 31.69,
"text": "Esto es un año muy urgente, muy luchada,"
},
{
"s": 31.81,
"e": 36.16,
"text": "con el equipo que se pierde, con muchas cosas."
},
{
"s": 46.78,
"e": 48.94,
"text": "Es como más que un equipo, es una familia."
},
{
"s": 48.94,
"e": 51.94,
"text": "Y se lo damos la vida a un gran líder."
}

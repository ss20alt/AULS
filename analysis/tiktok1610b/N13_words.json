"sents": [
{
"s": 0.0,
"e": 6.74,
"text": "Nuestro puré a cangüé que vamos a compartir hoy en la mesa con mi familia va a ser al tatacuá."
},
{
"s": 7.86,
"e": 13.66,
"text": "Vine hasta la casa de mi vecina Carolina para que me preste su tatacuá."
},
{
"s": 13.7,
"e": 20.38,
"text": "Acá está mi niño ayudando a que el tatacuá esté en condiciones."
},
{
"s": 20.38,
"e": 30.66,
"text": "en contados minutos va a ingresar este rico y delicioso curé a cangüe que vamos a compartir"
},
{
"s": 30.66,
"e": 41.64,
"text": "estamos dando la última pincelada para que ingrese al tataco después verán ustedes"
},
{
"s": 41.64,
"e": 52.14,
"text": "lo riquísimo que será este curé a cangüé no puede faltar la rica sopa paraguaya estamos"
},
{
"s": 56.43,
"e": 64.81,
"text": "sacando del tatacua nuestro curé a cangüé que vamos a estar compartiendo en contados"
},
{
"s": 64.81,
"e": 72.87,
"text": "minutos con la familia miren ustedes cómo quedó esto se ve muy delicioso"
}
]

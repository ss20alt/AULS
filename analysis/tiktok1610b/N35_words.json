"sents": [
{
"s": 0.0,
"e": 7.9,
"text": "Un año de un gran sueño, formar causa republicana para recuperar los valores y principios del Partido Colorado."
},
{
"s": 8.2,
"e": 13.12,
"text": "El respeto a la militancia, el buscar la participación de la juventud,"
},
{
"s": 13.12,
"e": 17.76,
"text": "que hoy agradezco que estén acá para festejar nuestro primer aniversario."
},
{
"s": 17.9,
"e": 22.54,
"text": "Recordarle con cariño al senador Juan Afara para su pronta recuperación."
},
{
"s": 22.78,
"e": 29.3,
"text": "Arnaldo y yo, y él, iniciamos esto que hoy tiene una gran fuerza a nivel nacional."
},
{
"s": 29.3,
"e": 40.24,
"text": "Con candidatos y candidatas a concejales, con candidatos a intendentes y con una gran participación de mujeres, de jóvenes y de caudillos."
},
{
"s": 40.4,
"e": 46.72,
"text": "Causa Republicana representa hoy a los principios y valores del Partido Colorado."
},
{
"s": 46.72,
"e": 65.6,
"text": "Vamos a construir un plan alternativo para el 2028 donde se priorice la educación, la salud y el trabajo para que el ciudadano pueda realmente sentirse que el Partido Colorado en función del gobierno responde a su expectativa."
},
{
"s": 65.6,
"e": 78.6,
"text": "Gracias jóvenes por participar hoy de esta jornada y vamos a ser la escuela de liderazgo de la juventud en causa para que ustedes representen nuestra causa."
},
{
"s": 78.9,
"e": 83.28,
"text": "Nos vemos. ¡Viva el Partido Colorado! ¡Viva Causa Republicana!"
}
]

"sents": [
{
"s": 0.02,
"e": 4.22,
"text": "No va más. Urgente hay que buscar la solución de este tema."
},
{
"s": 4.42,
"e": 9.0,
"text": "Es pedirle primero al Presidente de la República, a través de la Ministra de Salud,"
},
{
"s": 9.06,
"e": 15.4,
"text": "que no acepte estas renuncias de estas personas que les puedo asegurar"
},
{
"s": 15.4,
"e": 18.7,
"text": "llegan a esta instancia porque no se les escucha."
},
{
"s": 18.88,
"e": 24.02,
"text": "No existen médicos menos cardiólogos pediátricos,"
},
{
"s": 24.02,
"e": 28.5,
"text": "terapistas pediátricos, anestesiólogos pediátricos."
},
{
"s": 28.5,
"e": 36.24,
"text": "¿Ustedes creen que ellos quieren hacer? No, les pido a todos que a través del diálogo se pueda destrabar."
},
{
"s": 36.4,
"e": 42.46,
"text": "Yo hice una propuesta concreta y viable, porque tengo gente del sector de salud, médicos,"
},
{
"s": 42.52,
"e": 51.38,
"text": "y también gente del sector económico, y sé que mi propuesta es realizable si hay voluntad política de ambas partes."
},
{
"s": 51.38,
"e": 58.98,
"text": "A esto no se tendría que haber llegado. Los médicos anunciaron en junio que en agosto iban a hacer la huelga."
},
{
"s": 59.02,
"e": 62.38,
"text": "Había ese tiempo que se podía haber convocado una mesa de trabajo."
},
{
"s": 62.78,
"e": 67.24,
"text": "A esa propuesta única que hay, que es la mía, me tienen que responder."
},
{
"s": 67.58,
"e": 75.24,
"text": "Está bien, vamos a modificar, pero no se puede seguir así, presidente de la República, ministra de Salud y ministro de Economía."
},
{
"s": 75.34,
"e": 79.12,
"text": "No se puede seguir que una parte diga los cuatro puntos."
},
{
"s": 79.78,
"e": 82.7,
"text": "Ellos saben que a corto plazo eso es inviable."
},
{
"s": 82.88,
"e": 85.16,
"text": "Y por el otro lado, no se puede decir no hay plata."
},
{
"s": 85.3,
"e": 88.94,
"text": "Y no presenta una cifra alternativa y un cronograma."
},
{
"s": 88.94,
"e": 93.78,
"text": "Y la ministra que mete la carrera sanitaria o el escalafón, no."
},
{
"s": 93.86,
"e": 102.8,
"text": "Piso salarial. Propuse 7 millones con la intención de igualar y ordenar a todos los médicos con su piso salarial."
},
{
"s": 102.9,
"e": 106.32,
"text": "Primer vínculo. A partir de ahí, segundo vínculo se construye."
},
{
"s": 106.32,
"e": 112.9,
"text": "El tercer vínculo es una propuesta para que se lleve adelante en siete etapas y en 14 meses,"
},
{
"s": 113.06,
"e": 118.88,
"text": "para que el impacto económico que tenga que dar el Ejecutivo sea posible, sea factible."
},
{
"s": 118.94,
"e": 122.68,
"text": "De ahí que sé que mi propuesta es sostenible."
},
{
"s": 123.18,
"e": 126.5,
"text": "Conclusión, estas renuncias no se pueden aceptar."
}
]

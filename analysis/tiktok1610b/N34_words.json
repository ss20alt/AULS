"sents": [
{
"s": 0.0,
"e": 6.58,
"text": "Yo traigo una propuesta de solución porque toda crisis se destraba con diálogo."
},
{
"s": 7.8,
"e": 12.62,
"text": "Y solicité que ambas partes no pueden ser radicales,"
},
{
"s": 13.16,
"e": 19.48,
"text": "tanto desde el Ejecutivo, representado por la Ministra,"
},
{
"s": 19.48,
"e": 24.82,
"text": "de decir ya tengo todo solucionado, el Ministro de Economía decir no hay plata,"
},
{
"s": 24.82,
"e": 34.44,
"text": "Y de parte del sector de los médicos, diciendo que si no se cumple con los cuatro puntos, no van a parar."
},
{
"s": 34.78,
"e": 38.64,
"text": "Entonces, tiene que haber flexibilidad para el diálogo."
},
{
"s": 39.12,
"e": 41.6,
"text": "Yo traigo una propuesta de solución."
},
{
"s": 43.44,
"e": 44.76,
"text": "Entonces, vamos a esperar."
},
{
"s": 44.98,
"e": 46.44,
"text": "¿Cuál sería la propuesta de solución?"
},
{
"s": 46.44,
"e": 48.96,
"text": "Y no le voy a decir antes. Voy a proponer ahí."
},
{
"s": 49.18,
"e": 50.86,
"text": "Pero usted va a saber que es viable."
},
{
"s": 51.92,
"e": 54.0,
"text": "Y atender a uno de los cuatro puntos"
},
{
"s": 54.0,
"e": 55.48,
"text": "Al menos de los que están trayendo"
},
{
"s": 55.48,
"e": 56.22,
"text": "Es solucionar todo"
},
{
"s": 56.72,
"e": 57.96,
"text": "Si hay predisposición"
},
{
"s": 58.56,
"e": 59.0,
"text": "Gracias"
}
]

"sents": [
{
"s": 0.0,
"e": 4.06,
"text": "Ahora recibí la renuncia de 200 anestesiólogos."
},
{
"s": 4.06,
"e": 5.3,
"text": "¿Ustedes saben lo que eso significa?"
},
{
"s": 5.72,
"e": 10.82,
"text": "Sinceramente, nunca este precedente aconteció en el Ministerio de Salud Pública."
},
{
"s": 10.94,
"e": 12.66,
"text": "Las renuncias masivas."
},
{
"s": 12.7,
"e": 14.78,
"text": "Pero esto es un detonante."
},
{
"s": 14.86,
"e": 15.58,
"text": "Hay que parar."
},
{
"s": 15.74,
"e": 23.0,
"text": "Esta renuncia de los 200 anestesiólogos son personas que no pueden ser reemplazadas por su experiencia."
},
{
"s": 23.54,
"e": 29.28,
"text": "Entonces, urgente, antes del viernes, la solución a este problema que se va agravando."
},
{
"s": 29.28,
"e": 32.04,
"text": "Presidente a través del Ministerio de Economía"
},
{
"s": 32.04,
"e": 35.64,
"text": "Ustedes saben que de estos 200 que renunciaron"
},
{
"s": 35.64,
"e": 39.22,
"text": "De 22 médicos anestesiólogos en encarnación"
},
{
"s": 39.22,
"e": 40.32,
"text": "Renunciaron 19"
},
{
"s": 40.32,
"e": 43.12,
"text": "La ciudad de la Ministra de Salud"
},
{
"s": 43.12,
"e": 44.32,
"text": "En Ciudad del Este"
},
{
"s": 44.32,
"e": 46.98,
"text": "De 33 anestesiólogos"
},
{
"s": 46.98,
"e": 48.24,
"text": "Renunciaron 27"
},
{
"s": 48.24,
"e": 49.46,
"text": "Esto hay que parar"
},
{
"s": 49.46,
"e": 51.62,
"text": "En la mesa directiva propuse"
},
{
"s": 51.62,
"e": 54.1,
"text": "Exhortar al Presidente de la República"
},
{
"s": 54.1,
"e": 55.36,
"text": "Que solucione hoy"
},
{
"s": 55.36,
"e": 57.38,
"text": "Porque ellos saben de dónde sacar el dinero"
},
{
"s": 57.38,
"e": 58.68,
"text": "Ya está el dinero"
},
{
"s": 58.68,
"e": 64.66,
"text": "El ministro de Economía dijo acá en la mesa directiva que no hay dinero y después apareció 60 millones."
},
{
"s": 65.0,
"e": 72.38,
"text": "Quiere decir que si tienen la sensibilidad, la predisposición, la voluntad política, van a encontrar el dinero hoy."
},
{
"s": 72.48,
"e": 81.32,
"text": "Para asegurar el piso salarial y acordar por escrito los demás puntos que hacen a segundo vínculo, al tercer vínculo"
},
{
"s": 81.32,
"e": 87.96,
"text": "y a todas las otras propuestas que el sector de salud a través del Sindicato Nacional de Médicos hicieron llegar."
},
{
"s": 87.96,
"e": 92.2,
"text": "En junio comunicaron que en agosto iban a hacer su huelga."
},
{
"s": 92.24,
"e": 98.08,
"text": "Tenían estos dos meses para instalar una mesa de trabajo y evitar esta huelga."
},
{
"s": 98.18,
"e": 102.36,
"text": "Ustedes saben que con esta presentación de la renuncia de los anestesiólogos,"
},
{
"s": 102.36,
"e": 106.3,
"text": "1.500 cirugías al mes quedan suspendidas."
},
{
"s": 106.44,
"e": 109.6,
"text": "Vamos a tener la mesa de crisis, pero hoy se puede levantar la huelga,"
},
{
"s": 109.6,
"e": 113.68,
"text": "si hay la voluntad política, si el ministro de Economía presenta una contrapropuesta,"
},
{
"s": 113.7,
"e": 114.86,
"text": "por escrito y viable."
}
]

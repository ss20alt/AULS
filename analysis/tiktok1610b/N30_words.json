"sents": [
{
"s": 0.0,
"e": 3.86,
"text": "No hay descripción del dolor de todas las familias afectadas."
},
{
"s": 4.1,
"e": 8.56,
"text": "No solamente el Senado está de luto por haber perdido a dos funcionarios."
},
{
"s": 8.88,
"e": 14.22,
"text": "El Paraguay está de luto por todos los demás paraguayos y paraguayas"
},
{
"s": 14.22,
"e": 19.92,
"text": "que fallecieron, se accidentaron y tuvieron este terrible final."
},
{
"s": 20.46,
"e": 25.52,
"text": "Propuse el nombramiento del hijo de Fátima y de su esposo,"
},
{
"s": 25.6,
"e": 27.84,
"text": "que es lo mínimo que corresponde."
},
{
"s": 27.84,
"e": 40.26,
"text": "Fue aceptado por la mesa directiva y en honor a la gran labor patriota, responsable, como funcionario solamente ambos, pero yo le conocí a Fátima."
},
{
"s": 40.42,
"e": 43.14,
"text": "Con esto no se soluciona el problema, decíamos."
},
{
"s": 43.48,
"e": 51.34,
"text": "Y también decirles, porque es un proyecto de ley que estoy trabajando hace casi dos años, de la inspección vehicular."
},
{
"s": 52.0,
"e": 59.46,
"text": "Ustedes saben que hay solamente 33 locales donde se pueden hacer las inspecciones de los vehículos y que es todo un negociado."
},
{
"s": 59.62,
"e": 63.0,
"text": "¿Por qué no hay en todos los lugares? ¿Por qué no hay en todos los municipios?"
},
{
"s": 63.0,
"e": 66.44,
"text": "Para dar la certificación de que ese vehículo está en condiciones."
},
{
"s": 66.84,
"e": 73.64,
"text": "Y nosotros, los ciudadanos comunes, nos exponemos a tener accidentes todos los días a consecuencia de esto,"
},
{
"s": 73.74,
"e": 79.14,
"text": "de que existen solamente esta cantidad y algunas veces se dan nomás luego el certificado que está en condiciones."
},
{
"s": 79.14,
"e": 86.82,
"text": "estamos normalizando lo que es indescriptible en el dolor ya hubo no sé cuántos feminicidios"
},
{
"s": 86.82,
"e": 94.04,
"text": "nuevamente en una semana esto duele en serio les digo y yo estoy cerca de la gente todos los días"
},
{
"s": 94.04,
"e": 101.26,
"text": "desde acá mis condolencias a los familiares a los amigos a los seres queridos de todas estas"
},
{
"s": 101.26,
"e": 108.8,
"text": "familias que fueron afectadas y en particular decirle al hijo de fátima aquí estamos y que"
},
{
"s": 108.8,
"e": 115.56,
"text": "Que Dios te dé la fortaleza y que tus padres desde arriba te bendigan para que seas un ciudadano de bien"
},
{
"s": 115.56,
"e": 119.6,
"text": "y le sirvas a nuestra patria desde acá, desde el Senado de la República."
}
]

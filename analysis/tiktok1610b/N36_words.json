"sents": [
{
"s": 0.0,
"e": 8.78,
"text": "Miren lo que vamos a saborear, curé sirirí hecho por el senador Juan Afara y me dijo vení ya porque ya se cocinó todo en el bracero."
},
{
"s": 8.9,
"e": 16.08,
"text": "Qué memoria de tradición que él mantiene a través de estas riquísimas comidas que siempre nos invita."
},
{
"s": 16.16,
"e": 19.46,
"text": "En este caso vamos a comer curé sirirí hecho por Juan Afara."
},
{
"s": 20.58,
"e": 31.84,
"text": "También vamos a mostrarles con qué vamos a combinar y a complementar este puré de suriri delicioso."
},
{
"s": 32.1,
"e": 37.74,
"text": "Lógicamente no puede faltar la sopa paraguaya y también el arroz queso."
},
{
"s": 38.48,
"e": 39.3,
"text": "¿Qué opinás Juan?"
},
{
"s": 39.58,
"e": 41.02,
"text": "Es espectacular, riquísimo."
},
{
"s": 41.2,
"e": 41.54,
"text": "Sigue."
},
{
"s": 42.02,
"e": 42.74,
"text": "Adelante."
},
{
"s": 42.94,
"e": 43.34,
"text": "Adelante."
}
]

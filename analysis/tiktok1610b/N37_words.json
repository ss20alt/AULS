],
"sents": [
{
"s": 0.0,
"e": 4.7,
"text": "Yo quiero agradecer a la senadora Lilian Samaniego, la organización de este espacio,"
},
{
"s": 4.98,
"e": 8.66,
"text": "la invitación a la provincia de Buenos Aires, al Ministerio de Ambiente,"
},
{
"s": 8.84,
"e": 14.36,
"text": "y venir a aprender también de la experiencia del gobierno y la administración paraguaya,"
},
{
"s": 14.6,
"e": 20.04,
"text": "que es fundamental para poder compartir criterios comunes,"
},
{
"s": 20.04,
"e": 22.56,
"text": "como dos países sudamericanos que somos,"
},
{
"s": 22.76,
"e": 26.88,
"text": "para proteger, descender nuestro ambiente y nuestros recursos,"
},
{
"s": 26.88,
"e": 34.26,
"text": "y poder garantizar para el pueblo y las generaciones que vienen la riqueza que hemos recibido."
},
{
"s": 34.52,
"e": 39.96,
"text": "Hay que valorar este tipo de encuentros, de conversatorios, seminarios,"
},
{
"s": 40.1,
"e": 50.08,
"text": "porque son espacios en donde uno tiene la posibilidad de entrelazar o conocer las actividades que desarrolla otro país, en este caso Argentina."
},
{
"s": 50.08,
"e": 59.28,
"text": "Yo celebro como Ministerio del Ambiente y Desarrollo Sostenible este tipo de eventos para enriquecer cada día más este tema tan importante para la vida humana."
},
{
"s": 59.38,
"e": 73.44,
"text": "Trasciendo todas nuestras experiencias de años en toda la temática del conversatorio, la verdad que lo interesante y todas las particularidades que tienen los dos países y que realmente hay muchísimas posibilidades de colaboración y estamos muy felices por ello."
},
{
"s": 73.44,
"e": 85.34,
"text": "Me parece muy enriquecedor escuchar mucho las experiencias de los hermanos argentinos para poder también comparar y saber cómo ellos están manejando los procesos ambientales en su país."
},
{
"s": 85.34,
"e": 105.94,
"text": "Este tipo de situaciones, conversatorios, reuniones, es fundamental para que todos los actores que forman parte del patrimonio nuestro, que es la parte productiva, la parte de transporte y sobre todo lo interesante, lidiar con otras experiencias de hermanos o países hermanos también es fundamental."
},
{
"s": 105.94,
"e": 120.24,
"text": "Es muy enriquecedor. Como ingeniero ambiental estoy aprendiendo bastante temas que hoy en día no son abordados en muchos lugares. Muy enriquecedor el abordaje de los delegados argentinos que están colaborando con el foro."
},
{
"s": 120.24,
"e": 132.4,
"text": "Celebro mucho la dinámica que se instauró hoy en el conversatorio ambiental, porque esas presentaciones relámpagos que se hacían justamente facilitaban esa dinámica de conversar, sobre todo con nuestros pares argentinos."
},
{
"s": 132.44,
"e": 144.88,
"text": "Celebré mucho la invitación de este lugar para el Ministerio del Ambiente, motivo a que se siga celebrando este tipo de espacios abiertos para poder hablar sobre todo con nuestros congéneres internacionales."
},
{
"s": 144.88,
"e": 153.06,
"text": "Y la verdad que es súper entusiasmado por este conversatorio, que la verdad yo soy argentino y es un nexo súper necesario para temas ambientales,"
},
{
"s": 153.08,
"e": 159.5,
"text": "que nosotros tenemos proyectos ambientales y bueno, viendo de qué manera se puede potenciar todo lo que se esté trabajando de un lado y lo que se está desarrollando acá."
},
{
"s": 159.68,
"e": 169.08,
"text": "Un gran evento, una gran jornada que cuenta con técnicos, técnicas de distintas instituciones y yo me siento muy contenta de inaugurar esto."
},
{
"s": 169.08,
"e": 175.28,
"text": "Soy la vicepresidenta de la Comisión del Medio Ambiente y Recursos Naturales del Senado de la República."
}
]
}
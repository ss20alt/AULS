"sents": [
{
"s": 0.0,
"e": 2.68,
"text": "Yo quisiera hacer una propuesta puntual."
},
{
"s": 2.74,
"e": 8.26,
"text": "Primero, he solicitado a través de un pedido de informes al Ministerio de Obras Públicas,"
},
{
"s": 8.3,
"e": 11.16,
"text": "que está en la lista entre los pedidos de informes."
},
{
"s": 11.22,
"e": 16.24,
"text": "Quisiera agregar también a la Municipalidad de Pacaraí el mismo pedido de informes,"
},
{
"s": 16.32,
"e": 20.98,
"text": "decirles que el Estado había expropiado la tierra al norte y al sur,"
},
{
"s": 21.06,
"e": 23.46,
"text": "y esas tierras se tasaron judicialmente,"
},
{
"s": 23.46,
"e": 29.88,
"text": "pero luego los beneficiarios solicitaron que se amplíe la tasación en cifras imposibles de pagarse."
},
{
"s": 29.96,
"e": 33.62,
"text": "La justicia no avanzó y se repitió otro gravísimo accidente."
},
{
"s": 33.66,
"e": 37.68,
"text": "Recordar también que la Procuraduría General de la República tiene a su cargo"
},
{
"s": 37.68,
"e": 40.86,
"text": "la representación y defensa de los intereses del Estado."
},
{
"s": 41.1,
"e": 48.68,
"text": "Y mi propuesta, presidente, es que el pedido de informes que había solicitado cuando venga la ministra,"
},
{
"s": 48.68,
"e": 53.42,
"text": "determinar ya, presidente, cuándo vamos a convocarle a la ministra al Senado"
},
{
"s": 53.42,
"e": 57.3,
"text": "con los documentos en mano y las respuestas concretas."
},
{
"s": 57.34,
"e": 63.44,
"text": "Una auditoría técnica independiente de todo el tramo de Pedroso, incluyendo la pendiente,"
},
{
"s": 63.54,
"e": 68.22,
"text": "la rampa de frenado, el semáforo, la iluminación y la señalización."
},
{
"s": 68.52,
"e": 72.56,
"text": "Un plan de emergencia operativa a las 24 horas"
},
{
"s": 72.56,
"e": 83.58,
"text": "Y una mesa de seguimiento con autoridades técnicas, con los vecinos y familiares de las víctimas, acompañado de un informe semanal sobre el avance de la obra."
},
{
"s": 83.78,
"e": 86.12,
"text": "Acá hubo responsables penales, presidente."
},
{
"s": 86.6,
"e": 92.3,
"text": "No se puede aceptar que toda la investigación termine con el conductor y no se examine la gestión pública."
},
{
"s": 92.3,
"e": 102.38,
"text": "También agregar el informe para el intendente de Pacaraí y como dijeron los colegas, llegar hasta el final de los responsables para concluir, presidente."
},
{
"s": 102.8,
"e": 108.52,
"text": "Pongo a consideración toda esta propuesta y me gustaría que se lleve a votación, presidente."
},
{
"s": 109.04,
"e": 116.06,
"text": "A votación, pedido de la senadora y a través de la presidencia nosotros vamos a convocarle a la ministra el próximo lunes."
}
]
}
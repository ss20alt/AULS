"sents": [
{
"s": 0.0,
"e": 2.5,
"text": "Pero lo que ella dijo acá es mentira."
},
{
"s": 2.6,
"e": 8.24,
"text": "Rosana dice que Lilian es malintencionada, afirmó la autora Rosana González,"
},
{
"s": 8.46,
"e": 12.28,
"text": "al responder las declaraciones de la senadora Lilian Samaniego,"
},
{
"s": 12.42,
"e": 16.76,
"text": "atribuyendo sus críticas a un conflicto personal del pasado."
},
{
"s": 17.12,
"e": 20.94,
"text": "No sé de qué habla. Yo le felicité a ella por su logro."
},
{
"s": 21.02,
"e": 24.36,
"text": "La dirigente señaló que existe un trasfondo personal."
},
{
"s": 24.36,
"e": 32.52,
"text": "Su marido fue nuestro abogado durante 10 años, pero hace 3 o 4 años cortamos nexos con ellos."
},
{
"s": 32.7,
"e": 36.36,
"text": "Quedó algo particular contra el sindicato y contra mi persona."
},
{
"s": 36.66,
"e": 39.96,
"text": "Es una ánima aversión que percibo."
},
{
"s": 40.16,
"e": 43.14,
"text": "Manifestó en contacto con la 1020 AM."
},
{
"s": 43.48,
"e": 46.06,
"text": "Pero lo que ella dijo acá es mentira."
},
{
"s": 46.14,
"e": 52.22,
"text": "Mi esposo no le conoce a nadie, ni se metió de ser asesor nunca de ellos."
},
{
"s": 52.22,
"e": 56.0,
"text": "Él es licenciado en administración y no tiene nada que ver."
},
{
"s": 56.1,
"e": 64.14,
"text": "Entonces, y espero que la autora Rosana González se retracte, porque mi marido ni conoce el cinamete."
}
]

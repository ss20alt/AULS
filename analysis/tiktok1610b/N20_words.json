"sents": [
{
"s": 27.45,
"e": 31.15,
"text": "Soy una persona"
},
{
"s": 31.15,
"e": 32.97,
"text": "que te reconoce"
},
{
"s": 32.97,
"e": 34.25,
"text": "que te valora"
},
{
"s": 34.25,
"e": 36.35,
"text": "Por mantener nuestra cultura"
},
{
"s": 36.35,
"e": 37.69,
"text": "Nuestra identidad"
},
{
"s": 48.09,
"e": 52.67,
"text": "Y me marcaste mi vida"
},
{
"s": 52.67,
"e": 54.83,
"text": "Por ese patriotismo"
},
{
"s": 54.83,
"e": 55.99,
"text": "Y esa dinámica"
},
{
"s": 55.99,
"e": 58.85,
"text": "Que vos lo das con tanta convicción"
},
{
"s": 58.85,
"e": 60.01,
"text": "Y entrega"
},
{
"s": 60.01,
"e": 61.73,
"text": "A nuestro idioma guaraní"
},
{
"s": 61.73,
"e": 62.91,
"text": "Que es nuestra identidad"
},
{
"s": 62.91,
"e": 65.15,
"text": "y hoy me hace muy feliz"
},
{
"s": 65.15,
"e": 67.41,
"text": "verte sano, verte de pie"
},
{
"s": 68.59,
"e": 69.27,
"text": "merecidísimo"
},
{
"s": 69.27,
"e": 70.57,
"text": "este reconocimiento"
},
{
"s": 70.57,
"e": 72.91,
"text": "a vos y a todo el grupo"
},
{
"s": 72.91,
"e": 74.89,
"text": "de senadores, de diputados"
},
{
"s": 74.89,
"e": 77.35,
"text": "que se unieron en el Día del Idioma Guaraní"
},
{
"s": 77.35,
"e": 78.67,
"text": "en el tiempo de agosto"
},
{
"s": 78.67,
"e": 80.81,
"text": "y en una primavera"
},
{
"s": 80.81,
"e": 82.51,
"text": "de nuestra identidad"
},
{
"s": 82.51,
"e": 85.07,
"text": "gracias a vos por esas oportunidades"
},
{
"s": 85.07,
"e": 87.07,
"text": "en esa zona, con tu hermano"
},
{
"s": 87.07,
"e": 87.89,
"text": "y otros más también"
},
{
"s": 87.89,
"e": 88.79,
"text": "y seguiremos"
},
{
"s": 88.79,
"e": 90.71,
"text": "suerte, muchas gracias"
},
{
"s": 92.91,
"e": 94.53,
"text": "Gracias por ver el video."
}
]

"sents": [
{
"s": 0.0,
"e": 8.06,
"text": "Cayó el Partido Colorado después de muchas décadas de estar en el poder y deciden entregarle a una mujer la conducción de la crisis."
},
{
"s": 8.4,
"e": 15.98,
"text": "Y recayó en mí, primero en forma interina y posteriormente a los 121 años de historia del partido,"
},
{
"s": 16.12,
"e": 21.18,
"text": "fui elegida la primera mujer de la Asociación Nacional Republicana Partido Colorado."
},
{
"s": 22.5,
"e": 30.98,
"text": "y eso porque por la misma razón que contaban cada una de ellas porque asumí entre todos trabajamos"
},
{
"s": 30.98,
"e": 36.24,
"text": "y el partido volvió al poder en el primer desafío cuando decían que el partido nunca"
},
{
"s": 36.24,
"e": 42.44,
"text": "más volvería al poder fui la presidenta de la crisis y de la victoria del partido y mi"
},
{
"s": 42.44,
"e": 49.76,
"text": "trayectoria queridas mujeres que están aquí demuestra que cuando la mujer se decide lo logra"
}
]
